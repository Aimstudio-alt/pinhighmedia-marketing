---
const year = new Date().getFullYear()

const columns = [
  {
    heading: 'Products',
    links: [
      { label: 'CountyConsent', href: 'https://countyconsent.co.uk' },
      { label: 'ClubSentinel',  href: 'https://clubsentinel.co.uk' },
      { label: 'All products',  href: '/products' },
    ],
  },
  {
    heading: 'Studio',
    links: [
      { label: 'About',        href: '/about' },
      { label: 'Case studies', href: '/case-studies' },
      { label: 'Contact',      href: '/contact' },
    ],
  },
  {
    heading: 'Elsewhere',
    links: [
      { label: 'LinkedIn',  href: '#' },
      { label: 'Email us',  href: 'mailto:hello@pinhighmedia.co.uk' },
    ],
  },
]
---

<footer class="ph-footer">
  <div class="ph-container">
    <div class="ph-footer-top">
      <div>
        <a href="/" class="ph-logo">
          <span>pinhigh</span>
          <span class="ph-logo-dot" aria-hidden="true"></span>
        </a>
        <p class="ph-footer-tag">Specialist software for UK golf clubs &amp; county unions.</p>
      </div>

      <div class="ph-footer-cols">
        {columns.map((col) => (
          <div class="ph-footer-col">
            <div class="ph-footer-h">{col.heading}</div>
            {col.links.map((l) => (
              <a href={l.href} class="ph-footer-link">{l.label}</a>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="ph-footer-bot">
      <span>© {year} Pin High Media Ltd · Built in Durham, UK</span>
      <span class="ph-footer-status">
        <span class="ph-pulse" aria-hidden="true"></span>
        All systems operational
      </span>
    </div>
  </div>
</footer>
