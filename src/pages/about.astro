---
import Layout from '../layouts/Layout.astro'
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro'

const title = 'About — Pin High Media'
const description = 'Pin High Media is a specialist software studio for the UK golf industry, building tools designed around how clubs, county unions, and tour organisers actually work.'
---

<Layout title={title} description={description}>

  <section class="ph-page-head">
    <div class="ph-container">
      <span class="ph-eyebrow">About</span>
      <h1 class="ph-page-h1">Software built for an industry that deserves better.</h1>
    </div>
  </section>

  <section class="ph-about-body">
    <div class="ph-container ph-about-grid">
      <div class="ph-about-prose">
        <p>
          Pin High Media builds tools for golf clubs, county unions, and tour organisers — designed around how clubs actually work, not how a generic software company thinks they do.
        </p>
        <p>
          Most of the software sold to UK golf clubs wasn't built for them. Generic compliance platforms were designed for warehouses. Facilities tools were built for office blocks. Booking systems came from restaurants. Clubs adapt — because they have to — but they deserve better.
        </p>
        <p class="ph-pull">So we build better.</p>
        <p>
          Founded by Kev Jager, Pin High combines deep golf industry knowledge with modern software engineering. We work with clubs and county unions across England, Scotland, Wales, and Ireland, building tools for the things clubs actually spend their time on — safeguarding, health &amp; safety compliance, member communications, competition management, and more.
        </p>
        <p>
          Our two flagship products, <a href="https://countyconsent.co.uk" target="_blank" rel="noopener noreferrer" style="color:var(--accent);border-bottom:1px solid var(--accent-tint)">CountyConsent</a> and <a href="https://clubsentinel.co.uk" target="_blank" rel="noopener noreferrer" style="color:var(--accent);border-bottom:1px solid var(--accent-tint)">ClubSentinel</a>, are live with Durham County Golf Union and Wearside Golf Club, with further partners joining through 2026.
        </p>
        <p>If you're tired of software that wasn't built for you, let's talk.</p>

        <div style="margin-top: 8px;">
          <a href="/contact" class="ph-btn ph-btn-primary" style="display:inline-flex;">
            Get in touch
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
          </a>
        </div>
      </div>

      <aside class="ph-about-side">
        <PhotoPlaceholder kind="portrait" ratio="3/4" label="Kev Jager" />
        <div class="ph-about-card">
          <div class="ph-about-card-name">Kev Jager</div>
          <div class="ph-about-card-role">Founder &amp; principal engineer</div>
          <p class="ph-about-card-bio">15 years in software, lifelong golfer. Built Pin High Media to fix the tools clubs are forced to put up with.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="ph-closing">
    <div class="ph-closing-inner">
      <h2 class="ph-closing-h">Software that understands golf.</h2>
      <p class="ph-closing-p">
        Tell us what your club, county, or tour is wrestling with — we probably know the problem already.
      </p>
      <div class="ph-hero-ctas ph-closing-ctas">
        <a href="/contact" class="ph-btn ph-btn-primary">
          Get in touch
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
