---
import Layout from '../../layouts/Layout.astro'
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro'

const title = 'Wearside Golf Club — Pin High Media'
const description = 'How Pin High made Wearside Golf Club audit-ready overnight — ClubSentinel, a new website, and F&B booking rolled out in 6 weeks.'

const stats = [
  { v: '100%', k: 'Compliance documentation digitised in 6 weeks' },
  { v: '3',    k: 'Legacy systems retired' },
  { v: '24/7', k: 'Live compliance score for the club captain' },
]

const products = ['ClubSentinel', 'Integrated Website', 'Bar & Kitchen Booking']
---

<Layout title={title} description={description}>

  <section class="ph-page-head">
    <div class="ph-container">
      <div class="ph-back"><a href="/case-studies">← All case studies</a></div>
      <h1 class="ph-page-h1">Wearside Golf Club</h1>
      <p class="ph-page-lede">
        A members' club, made audit-ready overnight.
      </p>
    </div>
  </section>

  <section>
    <div class="ph-container">
      <div class="ph-case-detail-art">
        <PhotoPlaceholder kind="course" ratio="21/9" />
      </div>
    </div>
  </section>

  <section class="ph-case-detail-body">
    <div class="ph-container ph-case-detail-grid">
      <div>
        <h2 class="ph-case-detail-h">The problem</h2>
        <p>
          Wearside Golf Club had no system for health &amp; safety compliance. Incidents were logged in a spreadsheet (sometimes). Training records existed across multiple files. Asset tracking was non-existent. A routine audit would have been a nightmare. The club captain had no way to know, at any given moment, whether the club was actually compliant.
        </p>

        <h2 class="ph-case-detail-h">The system we built</h2>
        <ul class="ph-case-detail-list">
          {products.map((p) => <li>{p}</li>)}
        </ul>

        <h2 class="ph-case-detail-h">How it works now</h2>
        <p>
          ClubSentinel gives Wearside's captain a live compliance score, updated in real time as incidents are logged, training is completed, and documents are reviewed. RIDDOR-ready incident reporting means the club is always prepared — not scrambling after the fact. The integrated website replaced three separate systems, and F&B booking brought the bar and function room bookings into the same platform the club already uses for everything else.
        </p>
        <p>
          Three legacy systems were retired in the first six weeks. The club went from zero visibility to a 24/7 compliance dashboard.
        </p>
      </div>

      <aside class="ph-case-detail-side">
        <div class="ph-case-detail-stats">
          {stats.map((s) => (
            <div>
              <div class="ph-metric-v">{s.v}</div>
              <div class="ph-metric-k">{s.k}</div>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="ph-closing">
    <div class="ph-closing-inner">
      <h2 class="ph-closing-h">Software that understands golf.</h2>
      <p class="ph-closing-p">Tell us what your club, county, or tour is wrestling with — we probably know the problem already.</p>
      <div class="ph-hero-ctas ph-closing-ctas">
        <a href="/contact" class="ph-btn ph-btn-primary">
          Get in touch
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
        <a href="/case-studies" class="ph-btn ph-btn-ghost">
          All case studies
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
