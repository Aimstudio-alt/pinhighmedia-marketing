---
import Layout from '../layouts/Layout.astro'
import ProductMock from '../components/ProductMock.astro'

const title = 'Products — Pin High Media'
const description = 'Two flagship SaaS products and a suite of focused tools for UK golf clubs and county unions — CountyConsent, ClubSentinel, and specialist tools built for the realities of club operations.'

const flagships = [
  {
    name: 'CountyConsent',
    domain: 'countyconsent.co.uk',
    tagline: 'Junior golf parental consent and safeguarding, properly digital.',
    description: 'Replace paper forms, WhatsApp chains, and shared spreadsheets with one secure, GDPR-compliant system for clubs, counties, and tour organisers.',
    bullets: [
      'GDPR-compliant signed consent flow',
      'Per-event, per-season, or per-tour consents',
      'Auto-archive for safeguarding audits',
    ],
  },
  {
    name: 'ClubSentinel',
    domain: 'clubsentinel.co.uk',
    tagline: 'Health & safety compliance and asset management, powered by AI.',
    description: 'RIDDOR-ready incident reporting, training records, document management, and a live compliance score — designed to keep your club audit-ready, automatically.',
    bullets: [
      'AI-assisted incident classification',
      'Asset register with service reminders',
      'Live compliance score for the captain',
    ],
  },
]

const tools = [
  { name: 'Courtesy System',       blurb: 'Automates inter-club courtesy at county level. Configure rules, manage approvals, and give members a clear view of where they can play.' },
  { name: 'Golf League Tracker',   blurb: 'Automated league management for club leagues. Player selection, weekly group draws, live standings, and automatic WHS handicap maths.' },
  { name: 'Golf Genius Connector', blurb: "A bridge between Golf Genius and your club's specific workflows. Closes the gaps between events, admin, billing, and communications." },
  { name: 'Bar & Kitchen Booking', blurb: 'Integrated F&B booking built for club venues. Members book tables, events, and functions directly.' },
  { name: 'Newsletter System',     blurb: 'Member communications built into the club ecosystem. Send targeted newsletters and event updates without a separate platform.' },
  { name: 'Marketing Survey',      blurb: 'Data collection and insight tools for county golf bodies. Run surveys, track participation, make informed decisions.' },
  { name: 'Club Websites',         blurb: 'Modern, connected club websites. Member areas, booking integrations, news, and fixtures — all in one place.' },
  { name: 'Drone Videography',     blurb: 'Professional course flyovers and promotional content for clubs and county competitions.' },
]
---

<Layout title={title} description={description}>

  <!-- Page head -->
  <section class="ph-page-head">
    <div class="ph-container">
      <span class="ph-eyebrow">What we build</span>
      <h1 class="ph-page-h1">Products &amp; tools.</h1>
      <p class="ph-page-lede">
        Two flagship SaaS products and a suite of focused tools for UK golf clubs and county unions.
      </p>
    </div>
  </section>

  <!-- Flagships -->
  <section class="ph-flagships">
    <div class="ph-container">
      <div class="ph-section-head">
        <span class="ph-eyebrow">Flagship products</span>
        <h2 class="ph-section-title">Two SaaS products, live with real UK customers.</h2>
      </div>

      <div class="ph-flagship-grid">
        {flagships.map((p) => (
          <article class="ph-flagship">
            <div class="ph-flagship-head">
              <div>
                <h3 class="ph-flagship-name">{p.name}</h3>
                <div class="ph-flagship-domain">{p.domain}</div>
              </div>
              <span class="ph-status-pill">
                <span class="ph-pulse" aria-hidden="true"></span>
                Live
              </span>
            </div>
            <p class="ph-flagship-tag">{p.tagline}</p>
            <p class="ph-flagship-desc">{p.description}</p>
            <ul class="ph-flagship-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
            <ProductMock product={p.name as 'CountyConsent' | 'ClubSentinel'} />
            <a href={`https://${p.domain}`} class="ph-btn ph-btn-ghost" target="_blank" rel="noopener noreferrer">
              Visit {p.name}
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Specialist tools -->
  <section class="ph-tools">
    <div class="ph-container">
      <div class="ph-section-head">
        <span class="ph-eyebrow">Specialist tools</span>
        <h2 class="ph-section-title">Focused products that solve one thing properly.</h2>
        <p class="ph-section-lede">
          Alongside the flagships, we build focused tools that solve specific operational challenges. If one sounds like something you need, get in touch.
        </p>
      </div>
      <div class="ph-tools-grid">
        {tools.map((t, i) => (
          <article class="ph-tool">
            <div class="ph-tool-num">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="ph-tool-name">{t.name}</h3>
            <p class="ph-tool-blurb">{t.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="ph-closing">
    <div class="ph-closing-inner">
      <h2 class="ph-closing-h">Software that understands golf.</h2>
      <p class="ph-closing-p">
        Tell us what your club, county, or tour is wrestling with — we probably know the problem already.
      </p>
      <div class="ph-hero-ctas ph-closing-ctas">
        <a href="/contact" class="ph-btn ph-btn-primary">
          Get in touch
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
