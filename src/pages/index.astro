---
import Layout from '../layouts/Layout.astro'
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro'
import ProductMock from '../components/ProductMock.astro'

const title = 'Pin High Media — Software for UK golf clubs and county unions'
const description = 'Modern, modular software for UK golf clubs and county unions — CountyConsent, ClubSentinel, and specialist tools built for how clubs actually work.'

const metrics = [
  { value: '2',    label: 'Flagship SaaS products, live in production' },
  { value: '450+', label: 'Junior golfers safeguarded through CountyConsent' },
  { value: '12',   label: 'UK golf clubs & county unions onboarded' },
  { value: '0',    label: 'Spreadsheet incidents on our watch' },
]

const caseStudies = [
  {
    id: 'dcgu',
    client: 'Durham County Golf Union',
    kind: 'County union platform',
    year: '2025',
    headline: 'Replaced ten years of paper safeguarding with one signed-link flow.',
    summary: 'A bespoke county platform combining CountyConsent, the Courtesy System, and a fully integrated public website — saving hundreds of admin hours every season.',
    stats: [
      { v: '320+',  k: 'Junior tour consents processed in the first season' },
      { v: '14',    k: 'Member clubs using the courtesy system' },
      { v: '< 60s', k: 'Average time from consent request to signed return' },
    ],
    products: ['CountyConsent', 'Courtesy System', 'Integrated Website'],
    photoKind: 'course' as const,
  },
  {
    id: 'wearside',
    client: 'Wearside Golf Club',
    kind: 'Full club platform',
    year: '2024',
    headline: "A members’ club, made audit-ready overnight.",
    summary: 'ClubSentinel rolled out alongside a new website and integrated F&B booking. The club now runs RIDDOR-ready incident reporting, training records, and live compliance scoring from a single dashboard.',
    stats: [
      { v: '100%', k: 'Compliance documentation digitised in 6 weeks' },
      { v: '3',    k: 'Legacy systems retired' },
      { v: '24/7', k: 'Live compliance score for the club captain' },
    ],
    products: ['ClubSentinel', 'Integrated Website', 'Bar & Kitchen Booking'],
    photoKind: 'indoor' as const,
  },
]

const flagships = [
  {
    name: 'CountyConsent',
    domain: 'countyconsent.co.uk',
    tagline: 'Junior golf parental consent and safeguarding, properly digital.',
    description: 'Replace paper forms, WhatsApp chains, and shared spreadsheets with one secure, GDPR-compliant system for clubs, counties, and tour organisers.',
    bullets: [
      'GDPR-compliant signed consent flow',
      'Per-event, per-season, or per-tour consents',
      'Auto-archive for safeguarding audits',
    ],
  },
  {
    name: 'ClubSentinel',
    domain: 'clubsentinel.co.uk',
    tagline: 'Health & safety compliance and asset management, powered by AI.',
    description: 'RIDDOR-ready incident reporting, training records, document management, and a live compliance score — designed to keep your club audit-ready, automatically.',
    bullets: [
      'AI-assisted incident classification',
      'Asset register with service reminders',
      'Live compliance score for the captain',
    ],
  },
]

const tools = [
  { name: 'Courtesy System',       blurb: 'Automates inter-club courtesy at county level.' },
  { name: 'Golf League Tracker',   blurb: 'Live leaderboards, automatic scoring, no spreadsheets.' },
  { name: 'Golf Genius Connector', blurb: 'Closes the gaps between Golf Genius and your club admin.' },
  { name: 'Bar & Kitchen Booking', blurb: 'F&B booking integrated into the club ecosystem.' },
  { name: 'Newsletter System',     blurb: 'Member comms inside the platform you already use.' },
  { name: 'Marketing Survey',      blurb: 'Run county-level surveys, get usable data back.' },
  { name: 'Club Websites',         blurb: 'Modern, fully integrated club websites.' },
  { name: 'Drone Videography',     blurb: 'Course flyovers for marketing and member engagement.' },
]

const clients = ['Durham CGU', 'Wearside GC', 'Cleveland GU', 'Beamish Park', 'Brancepeth Castle', 'Seaham GC', 'Boldon GC']
---

<Layout title={title} description={description}>

  <!-- ── Hero ── -->
  <section class="ph-hero">
    <div class="ph-container ph-hero-grid">
      <div>
        <span class="ph-eyebrow">
          <span class="ph-eyebrow-dot" aria-hidden="true"></span>
          A specialist software studio for UK golf
        </span>
        <h1 class="ph-h1">
          Software built for how UK golf
          <em> actually works.</em>
        </h1>
        <p class="ph-lede">
          Modern, modular tools for clubs and county unions — purpose-built to add what bundled legacy systems do badly. Keep what works. Replace what doesn't.
        </p>
        <div class="ph-hero-ctas">
          <a href="/products" class="ph-btn ph-btn-primary">
            See what we build
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
          </a>
          <a href="/contact" class="ph-btn ph-btn-ghost">
            Talk to us
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
          </a>
        </div>
        <div class="ph-hero-quiet">
          <span>Live with</span>
          <strong>Durham County Golf Union</strong>
          <span>·</span>
          <strong>Wearside Golf Club</strong>
          <span>+ 10 more</span>
        </div>
      </div>

      <!-- Stack visual -->
      <div class="ph-stack" aria-hidden="true">
        <div class="ph-stack-card ph-stack-pinhigh">
          <div class="ph-stack-meta">
            <span class="ph-logo" style="font-size:14px">
              <span>pinhigh</span>
              <span class="ph-logo-dot"></span>
            </span>
            <span class="ph-stack-tag">Your operating layer</span>
          </div>
          <div class="ph-stack-rows">
            <div class="ph-stack-row"><span>CountyConsent</span><span class="ph-stack-pill">live</span></div>
            <div class="ph-stack-row"><span>ClubSentinel</span><span class="ph-stack-pill">live</span></div>
            <div class="ph-stack-row"><span>Courtesy System</span><span class="ph-stack-pill">live</span></div>
            <div class="ph-stack-row"><span>League Tracker</span><span class="ph-stack-pill">live</span></div>
          </div>
        </div>
        <div class="ph-stack-card ph-stack-legacy ph-stack-legacy-1">
          <div class="ph-stack-meta ph-stack-meta-faded">
            <span>Legacy CRM</span><span>Bundled, generic</span>
          </div>
        </div>
        <div class="ph-stack-card ph-stack-legacy ph-stack-legacy-2">
          <div class="ph-stack-meta ph-stack-meta-faded">
            <span>Tee Booking</span><span>Built for restaurants</span>
          </div>
        </div>
        <div class="ph-stack-card ph-stack-legacy ph-stack-legacy-3">
          <div class="ph-stack-meta ph-stack-meta-faded">
            <span>Compliance Tool</span><span>Designed for warehouses</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Client strip ── -->
  <div class="ph-strip">
    <div class="ph-strip-inner">
      <span class="ph-strip-label">Trusted by</span>
      <div class="ph-strip-list">
        {clients.map((c) => <span class="ph-strip-item">{c}</span>)}
      </div>
    </div>
  </div>

  <!-- ── Case studies ── -->
  <section class="ph-case-section">
    <div class="ph-container">
      <div class="ph-section-head">
        <span class="ph-eyebrow">Case studies</span>
        <h2 class="ph-section-title">When a club needs everything working together.</h2>
        <p class="ph-section-lede">
          Two full bespoke platforms currently live. Both started with one painful workflow — both ended with the club's entire operations on Pin High.
        </p>
      </div>

      <div class="ph-case-list">
        {caseStudies.map((c) => (
          <a href={`/case-studies/${c.id}`} class="ph-case-card">
            <div class="ph-case-art">
              <PhotoPlaceholder kind={c.photoKind} ratio="16/10" />
              <div class="ph-case-overlay">
                <span>{c.kind}</span>
                <span>·</span>
                <span>{c.year}</span>
              </div>
            </div>
            <div class="ph-case-body">
              <div class="ph-case-client">{c.client}</div>
              <h3 class="ph-case-head">{c.headline}</h3>
              <p class="ph-case-sum">{c.summary}</p>
              <div class="ph-case-stats">
                {c.stats.map((s) => (
                  <div>
                    <div class="ph-case-stat-v">{s.v}</div>
                    <div class="ph-case-stat-k">{s.k}</div>
                  </div>
                ))}
              </div>
              <div class="ph-case-products">
                {c.products.map((prod) => (
                  <span class="ph-chip">{prod}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Metrics ── -->
  <section class="ph-metrics">
    <div class="ph-container">
      <div class="ph-metrics-grid">
        {metrics.map((m) => (
          <div class="ph-metric">
            <div class="ph-metric-v">{m.value}</div>
            <div class="ph-metric-k">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Flagship products ── -->
  <section class="ph-flagships">
    <div class="ph-container">
      <div class="ph-section-head">
        <span class="ph-eyebrow">Flagship products</span>
        <h2 class="ph-section-title">Two SaaS products, live with real UK customers.</h2>
      </div>

      <div class="ph-flagship-grid">
        {flagships.map((p) => (
          <article class="ph-flagship">
            <div class="ph-flagship-head">
              <div>
                <h3 class="ph-flagship-name">{p.name}</h3>
                <div class="ph-flagship-domain">{p.domain}</div>
              </div>
              <span class="ph-status-pill">
                <span class="ph-pulse" aria-hidden="true"></span>
                Live
              </span>
            </div>
            <p class="ph-flagship-tag">{p.tagline}</p>
            <p class="ph-flagship-desc">{p.description}</p>
            <ul class="ph-flagship-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
            <ProductMock product={p.name as 'CountyConsent' | 'ClubSentinel'} />
            <a href={`https://${p.domain}`} class="ph-btn ph-btn-ghost" target="_blank" rel="noopener noreferrer">
              Visit {p.name}
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Specialist tools ── -->
  <section class="ph-tools">
    <div class="ph-container">
      <div class="ph-section-head">
        <span class="ph-eyebrow">Specialist tools</span>
        <h2 class="ph-section-title">Focused products that solve one thing properly.</h2>
        <p class="ph-section-lede">
          Alongside the flagships, we build smaller tools for specific operational jobs. If one sounds like something you need, get in touch.
        </p>
      </div>

      <div class="ph-tools-grid">
        {tools.map((t, i) => (
          <article class="ph-tool">
            <div class="ph-tool-num">{String(i + 1).padStart(2, '0')}</div>
            <h4 class="ph-tool-name">{t.name}</h4>
            <p class="ph-tool-blurb">{t.blurb}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Closing CTA ── -->
  <section class="ph-closing">
    <div class="ph-closing-inner">
      <h2 class="ph-closing-h">Software that understands golf.</h2>
      <p class="ph-closing-p">
        Tell us what your club, county, or tour is wrestling with — we probably know the problem already.
      </p>
      <div class="ph-hero-ctas ph-closing-ctas">
        <a href="/contact" class="ph-btn ph-btn-primary">
          Get in touch
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
        <a href="/products" class="ph-btn ph-btn-ghost">
          See all products
          <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 6h8m-3-3 3 3-3 3"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
