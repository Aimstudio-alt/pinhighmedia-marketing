---
import Layout from '../layouts/Layout.astro'

const title = 'Contact — Pin High Media'
const description = "Get in touch with Pin High Media — whether you're a club manager, a county secretary, or running a junior tour, we'd love to hear what you're wrestling with."
---

<Layout title={title} description={description}>

  <section class="ph-page-head">
    <div class="ph-container">
      <span class="ph-eyebrow">Contact</span>
      <h1 class="ph-page-h1">Let's talk about what you're building.</h1>
      <p class="ph-page-lede">
        Whether you're a club manager, a county secretary, or running a junior tour, we'd love to hear what you're wrestling with.
      </p>
    </div>
  </section>

  <section class="ph-contact">
    <div class="ph-container">
      <div class="ph-contact-grid">
        <a href="mailto:hello@pinhighmedia.co.uk" class="ph-contact-card">
          <div class="ph-contact-kind">Email</div>
          <div class="ph-contact-value">hello@pinhighmedia.co.uk</div>
          <p class="ph-contact-note">The fastest way to reach us. We aim to reply within a working day.</p>
          <span class="ph-contact-cta">Reach out →</span>
        </a>

        <a href="#" class="ph-contact-card">
          <div class="ph-contact-kind">LinkedIn</div>
          <div class="ph-contact-value">Connect with Kev</div>
          <p class="ph-contact-note">Founder and principal engineer at Pin High Media.</p>
          <span class="ph-contact-cta">View profile →</span>
        </a>
      </div>

      <div class="ph-contact-products">
        <div class="ph-contact-products-h">Looking for product information?</div>
        <div class="ph-contact-products-row">
          <a href="https://countyconsent.co.uk" target="_blank" rel="noopener noreferrer" class="ph-chip ph-chip-link">
            CountyConsent ↗
          </a>
          <a href="https://clubsentinel.co.uk" target="_blank" rel="noopener noreferrer" class="ph-chip ph-chip-link">
            ClubSentinel ↗
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
